alias vim="nvim"
alias vi="nvim"

alias icat="kitty +kitten icat --align left"
alias scrcpy="scrcpy -f -Sw -b 16M --lock-video-orientation 3 --window-width 1920 --window-height 1080 -m 1920"

alias ls="ls --color=auto --group-directories-first"
alias ll='ls -tcahlF'
alias la='ls -A'
alias l='ls -CF'

alias open="xdg-open"
alias less='NVIM_APPNAME=nvim-pager nvim -R'
